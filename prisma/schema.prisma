generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CommuneSettings {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeInsee       String    @unique @map("code_insee") @db.VarChar(5)
  disabledPlugins String[]  @default([]) @map("disabled_plugins")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("commune_settings")
}

enum RuralPathStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  CERTIFIED @map("certified")

  @@map("rural_path_status")
}

enum RuralPathSurface {
  EARTH  @map("terre")
  GRAVEL @map("gravier")
  PAVED  @map("enrobe")
  STONED @map("empierre")
  GRASS  @map("herbe")

  @@map("rural_path_surface")
}

enum RuralPathClassement {
  CHEMIN_RURAL   @map("chemin_rural")
  VOIE_COMMUNALE @map("voie_communale")

  @@map("rural_path_classement")
}

enum RuralPathEtat {
  EXCELLENT @map("excellent")
  BON       @map("bon")
  MOYEN     @map("moyen")
  MAUVAIS   @map("mauvais")

  @@map("rural_path_etat")
}

enum RuralPathDomanialite {
  INDETERMINE                   @map("indetermine")
  PRIVE                         @map("prive")
  PRIVE_OUVERT_A_LA_CIRCULATION @map("prive_ouvert_a_la_circulation")
  PUBLIC                        @map("public")

  @@map("rural_path_domanialite")
}

enum RuralPathSource {
  MANUEL  @map("manuel")
  BD_TOPO @map("bd_topo")

  @@map("rural_path_source")
}

model RuralPath {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeInsee   String              @map("code_insee") @db.VarChar(5)
  statut      RuralPathStatus     @default(DRAFT)
  nom         String?
  classement  RuralPathClassement
  numero      Int
  commentaire String?
  segments    RuralPathSegment[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([codeInsee])
  @@index([deletedAt])
  @@map("rural_paths")
}

model RuralPathSegment {
  id               String                                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruralPathId      String                                     @map("rural_path_id") @db.Uuid
  ruralPath        RuralPath                                  @relation(fields: [ruralPathId], references: [id])
  ordre            Int
  path             Json                                       @db.JsonB
  pathGeom         Unsupported("geometry(LineString, 4326)")? @map("path_geom")
  surface          RuralPathSurface
  largeurMoyenne   Int?                                       @map("largeur_moyenne")
  etatEntretien    RuralPathEtat?                             @map("etat_entretien")
  etatConservation RuralPathEtat?                             @map("etat_conservation")
  domanialite      RuralPathDomanialite?
  source           RuralPathSource                            @default(MANUEL)
  // Identifiant de l'objet dans la source externe (ex. "cleabs" BD TOPO), pour éviter les doublons au réimport.
  sourceRef        String?                                    @map("source_ref")
  createdAt        DateTime                                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?                                  @map("deleted_at") @db.Timestamptz(6)

  @@unique([ruralPathId, ordre])
  @@index([deletedAt])
  @@index([source, sourceRef])
  @@map("rural_path_segments")
}
