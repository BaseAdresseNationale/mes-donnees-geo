// Ce schéma reflète la structure gérée par les migrations SQL (migrations/*.sql).
// Prisma est utilisé comme client, pas comme gestionnaire de migrations :
// l'ENUM, la contrainte CHECK sur code_insee et le trigger updated_at
// sont maintenus côté base de données par scripts/migrate.mjs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BasemapKind {
  openmaptiles
  ortho
  ign

  @@map("basemap_kind")
}

model CommuneSettings {
  codeInsee       String      @id @map("code_insee") @db.VarChar(5)
  disabledPlugins String[]    @default([]) @map("disabled_plugins")
  basemap         BasemapKind @default(ortho)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("commune_settings")
}
