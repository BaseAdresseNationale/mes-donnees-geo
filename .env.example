# tuiles de la carte et à `npm run generate:api-bal` (lit <url>/api-json)
NEXT_PUBLIC_MES_ADRESSES_API_URL=https://api-bal.adresse.data.gouv.fr/
# Secret partagé avec mes-adresses-api (header x-client-secret), serveur uniquement
MES_DONNEES_GEO_CLIENT_SECRET=

# --- INSEE ---
